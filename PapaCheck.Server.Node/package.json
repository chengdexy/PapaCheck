{
  "name": "papacheck-server",
  "version": "1.2.0",
  "description": "PapaCheck（爸~检查！）- Node.js 服务器",
  "type": "module",
  "main": "dist/index.js",
  "bin": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc",
    "build:sea": "node scripts/build-sea.mjs",
    "test": "vitest run --config ../vitest.config.js",
    "test:watch": "vitest",
    "migrate:pg": "npx tsx scripts/migrate-to-pg.ts"
  },
  "pkg": {
    "assets": [
      "dist/scripts/**/*",
      "node_modules/better-sqlite3/**/*"
    ],
    "targets": [
      "node18-win-x64"
    ]
  },
  "dependencies": {
    "@fastify/cookie": "^9.4.0",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/static": "^7.0.0",
    "@fastify/swagger": "^8.15.0",
    "@fastify/swagger-ui": "^3.0.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^11.7.0",
    "fastify": "^4.28.0",
    "imap": "^0.8.19",
    "jsonwebtoken": "^9.0.3",
    "mailparser": "^3.9.9",
    "minimist": "^1.2.8",
    "pg": "^8.21.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.12",
    "@types/imap": "^0.8.43",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mailparser": "^3.4.6",
    "@types/minimist": "^1.2.5",
    "@types/node": "^22.13.0",
    "@types/pg": "^8.20.0",
    "@vitest/coverage-v8": "^3.2.6",
    "esbuild": "^0.25.0",
    "postject": "^1.0.0-alpha.6",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
