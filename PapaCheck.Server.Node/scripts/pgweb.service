[Unit]
Description=pgweb PostgreSQL Web Client
After=network.target postgresql.service

[Service]
Type=simple
User=papacheck
ExecStart=/usr/local/bin/pgweb \
  --url=postgresql://papacheck@localhost:5432/papacheck?sslmode=disable \
  --bind=127.0.0.1 \
  --port=9080 \
  --auth-static=CHANGE_ME_TO_RANDOM_PASSWORD \
  --readonly
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
